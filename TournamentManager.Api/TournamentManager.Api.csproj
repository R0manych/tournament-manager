<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>93c45d2d-03eb-4c61-aeee-8fdbb63ec9ce</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TournamentManager.Domain\**" />
    <Compile Remove="TournamentManager.Infrastructure\**" />
    <Compile Remove="TournamentManager.Tests\**" />
    <Content Remove="TournamentManager.Domain\**" />
    <Content Remove="TournamentManager.Infrastructure\**" />
    <Content Remove="TournamentManager.Tests\**" />
    <EmbeddedResource Remove="TournamentManager.Domain\**" />
    <EmbeddedResource Remove="TournamentManager.Infrastructure\**" />
    <EmbeddedResource Remove="TournamentManager.Tests\**" />
    <None Remove="TournamentManager.Domain\**" />
    <None Remove="TournamentManager.Infrastructure\**" />
    <None Remove="TournamentManager.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TournamentManager.Domain\TournamentManager.Domain.csproj" />
    <ProjectReference Include="..\TournamentManager.Infrastructure\TournamentManager.Infrastructure.csproj" />
  </ItemGroup>

</Project>
